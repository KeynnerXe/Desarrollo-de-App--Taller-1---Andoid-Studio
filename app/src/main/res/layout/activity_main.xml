<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/bg_light"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="32dp"
    android:paddingBottom="32dp">

    <!-- Espaciador flexible superior -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Ícono / Emblema de la App Minimalista -->
    <ImageView
        android:id="@+id/imgAppLogo"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:src="@drawable/minimal_finance_icon_1790377104389"
        android:contentDescription="@string/titulo_inicio"
        android:layout_marginBottom="24dp" />

    <!-- Título Principal Minimalista -->
    <TextView
        android:id="@+id/tvTituloBienvenida"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Finanzas"
        android:textColor="@color/text_primary"
        android:textSize="30sp"
        android:textStyle="bold"
        android:letterSpacing="-0.03"
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_marginBottom="6dp" />

    <!-- Subtítulo breve -->
    <TextView
        android:id="@+id/tvSubtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Herramientas de conversión y crédito"
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_marginBottom="44dp" />

    <!-- 
        HERRAMIENTAS CON IGUAL JERARQUÍA VISUAL:
        Ambos botones comparten exactamente el mismo peso visual, estilo,
        dimensiones, color de fondo, borde y tipografía.
    -->

    <!-- Herramienta 1: Convertidor de Moneda -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConvertidor"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="@string/btn_convertidor"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        app:backgroundTint="@color/surface_card"
        app:cornerRadius="14dp"
        app:strokeColor="@color/border_subtle"
        app:strokeWidth="1.5dp"
        app:icon="@drawable/ic_swap_currency"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconTint="@color/text_primary"
        app:rippleColor="@color/color_info_bg"
        android:layout_marginBottom="14dp" />

    <!-- Herramienta 2: Calculadora de Créditos (IDÉNTICA JERARQUÍA VISUAL) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCalculadora"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="@string/btn_calculadora"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        app:backgroundTint="@color/surface_card"
        app:cornerRadius="14dp"
        app:strokeColor="@color/border_subtle"
        app:strokeWidth="1.5dp"
        app:icon="@drawable/ic_calculator"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconTint="@color/text_primary"
        app:rippleColor="@color/color_info_bg"
        android:layout_marginBottom="28dp" />

    <!-- Espaciador flexible inferior -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Pie de página discreto -->
    <TextView
        android:id="@+id/tvFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/autor_info"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_gravity="center" />

</LinearLayout>
